# 비워두면 로컬 파일(.data/events.json)에 저장합니다 (개발용).
# 배포할 때는 Supabase 프로젝트를 만들고 supabase/schema.sql을 실행한 뒤 아래 두 값을 넣으세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 이벤트를 받을 프로젝트 키 (쉼표로 구분). 목록에 없는 키로 온 이벤트는 버립니다.
ALLOWED_KEYS=demo,portfolio

# 누구나 대시보드를 볼 수 있는 프로젝트 (쉼표로 구분, 기본 demo)
PUBLIC_KEYS=demo
# 나머지 프로젝트 대시보드를 볼 때 주소에 붙이는 비밀 값: /dashboard?key=portfolio&token=<이 값>
DASHBOARD_TOKEN=
